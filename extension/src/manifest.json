{
  "manifest_version": 3,
  "name": "lint.one",
  "short_name": "lint",
  "version": "0.4.1",
  "description": "Read the data you find on the web in a private viewer. Raw JSON is formatted where it opens. Nothing is uploaded.",
  "homepage_url": "https://lint.one/",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "lint.one",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "contextMenus",
    "declarativeContent",
    "scripting",
    "storage"
  ],
  "optional_permissions": [
    "tabCapture",
    "clipboardRead"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://lint.one/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "omnibox": {
    "keyword": "lint"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+L"
      },
      "description": "Open the lint.one menu"
    },
    "open-here": {
      "suggested_key": {
        "default": "Alt+Shift+O"
      },
      "description": "Open the selection, or this page, in lint.one"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
